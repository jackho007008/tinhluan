# Copy outside the release to /etc/tinhluan/beta.env, owner tinhluan, mode0600.
# Both services read this one file. No secrets belong in a release/archive.
NODE_ENV=production
DEPLOY_MODE=beta
APP_ORIGIN=https://beta.example.invalid
RECOVERY_ORIGIN=https://beta.example.invalid
CUSTOMER_ALLOWED_ORIGINS=
INTERNAL_REVIEW_ALLOWED_ORIGINS=
PORT=3000
CUSTOMER_PDF_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://tinhluan:REPLACE_ON_SERVER@127.0.0.1:5432/tinhluan_beta
INTERNAL_REVIEW_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INTERNAL_READING_DIR=/var/lib/tinhluan/internal-readings
TRIAL_READING_DIR=/var/lib/tinhluan/trial-readings
LOCAL_MAIL_DIR=/var/lib/tinhluan/mail-disabled
DEPLOY_STATE_DIR=/var/lib/tinhluan/run
BACKUP_DIR=/var/backups/tinhluan
FREE_TRIAL_ENABLED=true
# Separate old cohort-beta module stays off; public free flow is FREE_TRIAL_ENABLED.
BETA_ENABLED=false
DEMO_ENABLED=false
CORE_ORDER_TEST_ENABLED=false
SEPAY_TEST_ENABLED=false
SEPAY_LIVE_ENABLED=false
PAYMENT_PROVIDER=mock
READING_RECOVERY_ENABLED=true
EMAIL_PROVIDER=gmail-smtp
QA_LOCAL_MAIL_ENABLED=false
GMAIL_SMTP_ENABLED=true
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_TEST_TO=
# Existing Gmail adapter enforces exactly this recipient, STARTTLS587 and matching From.
# pg_dump/pg_restore must be same major as server or compatible newer version.
PG_DUMP_BIN=/usr/bin/pg_dump
PG_RESTORE_BIN=/usr/bin/pg_restore
