# Install in http{} scope, replace domain/certificate paths. Do not enable before TLS exists.
limit_req_zone $binary_remote_addr zone=tinhluan_api:10m rate=3r/s;
log_format tinhluan_safe '$time_iso8601 $request_method $uri $status $request_time';
server {
 listen 80;
 server_name beta.example.invalid;
 location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
 location / { return 301 https://beta.example.invalid$request_uri; }
}
server {
 listen 443 ssl;
 server_name beta.example.invalid;
 ssl_certificate /etc/letsencrypt/live/beta.example.invalid/fullchain.pem;
 ssl_certificate_key /etc/letsencrypt/live/beta.example.invalid/privkey.pem;
 ssl_protocols TLSv1.2 TLSv1.3;
 client_max_body_size 256k;
 client_body_timeout 15s;
 access_log /var/log/nginx/tinhluan.access.log tinhluan_safe;
 # Nginx error entries can include the full request/query (email token).
 # Keep them off; use sanitized app health codes. Do not enable debug/request logs.
 error_log /dev/null;
 # No payment endpoints in free beta; admin data remains readable behind app auth.
 location ^~ /api/payments/ { return 404; }
 location = /api/mock-pay { return 404; }
 location = /api/webhook { return 404; }
 location / {
  proxy_pass http://127.0.0.1:3000;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_http_version 1.1;
  proxy_buffering off;
  proxy_read_timeout 120s;
  proxy_connect_timeout 5s;
 }
 location /api/ {
  limit_req zone=tinhluan_api burst=20 nodelay;
  limit_req_status 429;
  proxy_pass http://127.0.0.1:3000;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_http_version 1.1;
  proxy_buffering off;
  proxy_read_timeout 120s;
  proxy_connect_timeout 5s;
 }
}
