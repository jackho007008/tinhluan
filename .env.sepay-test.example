# Server only. Separate SePay Test Mode webhook credentials. No Live adapter.
SEPAY_MODE=test
SEPAY_TEST_ENABLED=false
CORE_ORDER_TEST_ENABLED=true
# HMAC-SHA256 secret configured in SePay TEST MODE (>=32 characters). Do not send in chat.
SEPAY_TEST_WEBHOOK_SECRET=
# Exact values from a TEST MODE account / simulated webhook. No real bank account here.
SEPAY_TEST_GATEWAY=
SEPAY_TEST_ACCOUNT_NUMBER=
# Empty for a non-VA account; set exact value when using a test VA.
SEPAY_TEST_SUB_ACCOUNT=

# Separate server-side token from Test Mode → API Access. Sandbox host is fixed in code.
SEPAY_TEST_API_TOKEN=
