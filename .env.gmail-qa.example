# Copy to .env.gmail-qa (server only; never send this file in chat).
# Gmail full address. From is always exactly this account, display name Tinh Luận.
GMAIL_SMTP_USER=
# Google App Password (16 characters); not your normal Google password.
GMAIL_SMTP_APP_PASSWORD=
# Only this recipient may receive SMTP during QA.
GMAIL_SMTP_TEST_TO=
# Dedicated HTTPS origin for QA3070; no trailing path, query, or fragment.
RECOVERY_ORIGIN=
# Leave false until configuration + QA3070 HTTPS are checked.
GMAIL_SMTP_ENABLED=false
