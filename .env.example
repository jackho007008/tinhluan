DATABASE_URL=postgresql://localhost:55439/tuvi
APP_ORIGIN=http://localhost:3000
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=local
DEMO_ENABLED=true
# Chỉ development, dùng chuỗi ngẫu nhiên >=32 ký tự. Production không hỗ trợ mock.
MOCK_WEBHOOK_SECRET=replace-with-a-random-development-secret
# Quyền kiểm tra nội bộ riêng, không dùng token mua hàng. Tạo ngẫu nhiên >=32 ký tự.
INTERNAL_REVIEW_KEY=
# UUID báo cáo được chọn để kiểm tra; chỉ dùng phía server, không phải thông tin xác thực.
INTERNAL_REVIEW_ORDER_ID=

# Cờ phát hành beta riêng. Mặc định tắt; không bật nếu chưa có quyết định của chủ dự án.
BETA_ENABLED=false

# Các origin bổ sung chỉ cho đăng nhập/đăng xuất nội bộ, ngăn cách bằng dấu phẩy. Không dùng wildcard.
INTERNAL_REVIEW_ALLOWED_ORIGINS=

# Exact extra customer website origins, comma separated; no wildcard.
CUSTOMER_ALLOWED_ORIGINS=

# Optional private absolute directory for saved internal readings; default .local/internal-readings
# INTERNAL_READING_DIR=

# Khôi phục bản đọc: opt-in phía máy chủ; không bật gửi email thật.
READING_RECOVERY_ENABLED=false
# URL cố định của trang khôi phục. HTTPS khi tích hợp email thật.
RECOVERY_ORIGIN=
# Chỉ QA với database loopback và EMAIL_PROVIDER=local; cho phép hộp thư file trong production build.
QA_LOCAL_MAIL_ENABLED=false
# Thư mục riêng, không thuộc public/ và không đưa vào tài liệu bàn giao.
# LOCAL_MAIL_DIR=

# Historical Astra artifacts only; table 011 is needed only for legacy AI storage.
# Free V1 does not require this flag, an API key, or an AI worker.
AI_MENH_ENABLED=false
# Paid QA edition only; requires CHECKOUT_TEST_ENABLED=true and SEPAY_LIVE_ENABLED=false.
AI_PAID_ENABLED=false
# Reader supports V1/V2; enable V2 only for newly enqueued jobs in isolated QA.
AI_PAID_READING_V2_ENABLED=false
# Real consumer requires explicit report scope and 1..11 job budget.
# AI_PAID_PALACE=Quan Lộc
# AI_PAID_READING_ID=
# AI_PAID_MAX_NEW_JOBS=1
OPENAI_API_KEY=
# Gói 2.3: explicit purposes, no fallback across tiers. Verify project access.
AI_FREE_EDIT_MODEL=gpt-6-luna
AI_PAID_READING_MODEL=gpt-6-astra
# Private shared editorial artifacts; original reports remain immutable.
# AI_V1_EDIT_DIR=
# Legacy artifacts only. New purpose checks: npm run ai:check-model -- free-edit (or paid-reading).
# OPENAI_MODEL is not a fallback for either purpose.
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=high
AI_MENH_TIMEOUT_MS=120000
# Opt-in: retain provider responses for recovery; persist ID before polling.
# Background mode uses store=true. Review provider retention before enabling.
AI_MENH_BACKGROUND=false
AI_MENH_BACKGROUND_WAIT_MS=300000
AI_MENH_MAX_OUTPUT_TOKENS=12000
AI_MENH_MAX_DAILY_JOBS=20
# Legacy worker is now GET-only and requires an exact reading ID; no new CREATE.
# AI_MENH_READING_ID=
# AI_MENH_MAX_NEW_JOBS=1
# GET-only revalidation of a known response; requires an explicit reading ID.
# AI_MENH_REVALIDATE_OUTPUT=false
# Optional processed knowledge directory; never expose it as public assets.
AI_KNOWLEDGE_DIR=
# Optional verified per-million rates for the selected model; blank = unknown.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_CACHED_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
