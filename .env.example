DATABASE_URL=postgresql://localhost:55439/tuvi
APP_ORIGIN=http://localhost:3000
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=local
DEMO_ENABLED=true
# Chỉ development, dùng chuỗi ngẫu nhiên >=32 ký tự. Production không hỗ trợ mock.
MOCK_WEBHOOK_SECRET=replace-with-a-random-development-secret
# Quyền kiểm tra nội bộ riêng, không dùng token mua hàng. Tạo ngẫu nhiên >=32 ký tự.
INTERNAL_REVIEW_KEY=
# UUID báo cáo được chọn để kiểm tra; chỉ dùng phía server, không phải thông tin xác thực.
INTERNAL_REVIEW_ORDER_ID=

# Cờ phát hành beta riêng. Mặc định tắt; không bật nếu chưa có quyết định của chủ dự án.
BETA_ENABLED=false

# Các origin bổ sung chỉ cho đăng nhập/đăng xuất nội bộ, ngăn cách bằng dấu phẩy. Không dùng wildcard.
INTERNAL_REVIEW_ALLOWED_ORIGINS=

# Exact extra customer website origins, comma separated; no wildcard.
CUSTOMER_ALLOWED_ORIGINS=

# Optional private absolute directory for saved internal readings; default .local/internal-readings
# INTERNAL_READING_DIR=

# Khôi phục bản đọc: opt-in phía máy chủ; không bật gửi email thật.
READING_RECOVERY_ENABLED=false
# URL cố định của trang khôi phục. HTTPS khi tích hợp email thật.
RECOVERY_ORIGIN=
# Chỉ QA với database loopback và EMAIL_PROVIDER=local; cho phép hộp thư file trong production build.
QA_LOCAL_MAIL_ENABLED=false
# Thư mục riêng, không thuộc public/ và không đưa vào tài liệu bàn giao.
# LOCAL_MAIL_DIR=
